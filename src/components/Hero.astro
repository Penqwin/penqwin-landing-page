---
import ArrowRight from "../assets/svg/arrow-right.astro";
import DashboardPreview from "./DashboardPreview.astro";
---

<section
  id="hero"
  class="relative z-30 w-full md:min-h-screen bg-bg-main flex flex-col items-center justify-center"
>
  <div class="relative z-20 max-w-4xl px-6 mt-32 md:mt-48 text-center">
    <h1
      class="font-serif text-4xl md:text-6xl text-text-primary tracking-tight leading-[1.1] md:leading-[1.1] mb-10"
    >
      Documentation that stays in sync with your GitHub repository.
    </h1>

    <!-- Subtitle – problem/solution, secondary keywords -->
    <p
      class="text-text-secondary text-base md:text-lg max-w-2xl mx-auto leading-relaxed mb-10"
    >
      Connect your GitHub repository and automatically generate documentation
      your team can trust, without spending hours keeping it up to date.
    </p>

    <!-- Primary CTA -->
    <div
      class="flex flex-row text-sm items-center justify-center gap-4 my-10 md:my-8"
    >
      <a
        href="/docs"
        class="inline-flex select-none group items-center justify-center gap-2.5 px-4 md:px-8 py-4 bg-bg-secondary/50 border border-border rounded-xl text-text-primary font-medium hover:bg-white/10 transition-all cursor-pointer"
      >
        Documentation
      </a>

      <a
        id="hero-cta-primary"
        href="https://app.penqwin.com"
        class="group select-none relative inline-flex items-center active:scale-95 justify-center gap-3 px-4 md:px-8 py-4 bg-text-primary text-white rounded-xl font-bold transition-all duration-300"
        aria-label="Get Started"
      >
        <span>Get Started</span>
        <ArrowRight
          class="w-5 inline-block group-hover:translate-x-1"
          aria-hidden="true"
        />
      </a>
    </div>
  </div>
  <div
    class="hidden md:block w-full max-w-5xl mt-12 md:mt-16 mb-20 md:mb-32 px-4 md:px-6 relative z-10"
  >
    <DashboardPreview />
  </div>
</section>
