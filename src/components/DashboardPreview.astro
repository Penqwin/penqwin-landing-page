---
import ArrowIcon from "../assets/svg/arrow.astro";
import DocumentIcon from "../assets/svg/document.astro";
import FolderIcon from "../assets/svg/folder.astro";
import SaveIcon from "../assets/svg/save.astro";
import AutoAwsomeIcon from "../assets/svg/autoAwsome.astro";
import SearchIcon from "../assets/svg/search.astro";
import AiGenerateIcon from "../assets/svg/aiGenerate.astro";
// text formatting icons
import BoldIcon from "../assets/svg/text-formatting/bold.astro";
import ItalicIcon from "../assets/svg/text-formatting/italic.astro";
import UnderlineIcon from "../assets/svg/text-formatting/underline.astro";
import StrikethroughIcon from "../assets/svg/text-formatting/strikethrough.astro";
import CodeIcon from "../assets/svg/text-formatting/code.astro";
import penqwinWebpV2 from "../assets/images/penqwin-primary-v2.webp";
import penqwinPngV2 from "../assets/images/penqwin-primary-v2.png";
import Bullet from "../assets/svg/text-formatting/bullet.astro";
import MoreVert from "../assets/svg/text-formatting/moreVert.astro";

interface Props {
  /** 'changelog' – Changeset Summary expanded with changelog entries;
   *  default – Code Reference view (original behaviour) */
  variant?: "changelog" | "default";
}
const { variant = "default" } = Astro.props;
const isChangelog = variant === "changelog";

const changelogEntries = [
  { label: "Changelog Generation & DB Stability", active: true },
  { label: "Fix: TipTap Typing Glitch", active: false },
  { label: "Enhanced Code Reference Sync", active: false },
  { label: "Improved Navigation System", active: false },
  { label: "Editor Table Interactions", active: false },
  { label: "Refined Changelog Prompting", active: false },
];
---

<!-- Dashboard Showcase -->
<div class="dashboard-preview relative group px-2 md:px-0">
  <!-- Decorative Glow Border -->
  <div
    class="absolute -inset-0.5 bg-gradient-to-r from-primary-v1/30 to-accent/30 rounded-2xl blur-[10px] opacity-20 group-hover:opacity-40 transition duration-1000"
  >
  </div>

  <!-- Browser Frame -->
  <div
    class="relative bg-[#222222] w-full aspect-[16/10] border border-white/10 rounded-2xl shadow-2xl overflow-hidden transform transition-all duration-700"
  >
    <!-- Browser Header -->
    <div
      class="h-10 bg-[#222222] backdrop-blur-md border-b border-white/5 flex items-center px-4 gap-2"
    >
      <div class="flex gap-1.5">
        <div class="w-3 h-3 rounded-full bg-error/40"></div>
        <div class="w-3 h-3 rounded-full bg-warning/40"></div>
        <div class="w-3 h-3 rounded-full bg-success/40"></div>
      </div>
    </div>

    <!-- Dashboard -->
    <div class="w-full h-full text-text-primary-v1 flex">
      <!-- sidebar -->
      <div
        class="bg-bg-secondary-v1 w-1/4 h-full flex flex-col select-none relative"
      >
        <!-- sidebar content (scrollable) -->
        <div class="flex-1 overflow-y-auto custom-scrollbar px-6 pt-4 pb-2">
          <picture>
            <source srcset={penqwinWebpV2.src} type="image/webp" />
            <img
              src={penqwinPngV2.src}
              alt="Penqwin - Professional Engineering Documentation Platform"
              class="w-8 h-auto opacity-80"
            />
          </picture>
          <h3
            class="mt-4 text-text-primary-v1 text-[9.5px] flex gap-1 items-center justify-start font-semibold tracking-wide opacity-70"
          >
            Acme Corp <ArrowIcon
              class="w-auto h-2 rotate-90 text-text-secondary-v1"
            />
          </h3>

          <!-- Search bar -->
          <div
            class="border border-border-v1/50 hover:border-border-v1 px-2 py-1.5 rounded-full w-full mt-2 flex items-center justify-between text-text-muted-v1 hover:text-text-secondary-v1 transition-colors cursor-pointer"
          >
            <div class="flex items-center gap-2">
              <SearchIcon class="w-auto h-2.5" />
              <span class="text-[8px]">Global Search</span>
            </div>
            <span class="text-[8px]">⌘ + K</span>
          </div>

          <!-- sidebar entities -->
          <div class="mt-3 w-full flex flex-col text-[9px] tracking-tight">
            {
              isChangelog ? (
                <>
                  {/* ── CHANGELOG VARIANT ── */}

                  {/* Changeset Summary — EXPANDED */}
                  <div class="text-text-primary-v1 w-full flex justify-between gap-2 py-1 items-center cursor-pointer">
                    <div class="flex items-center gap-2 font-semibold">
                      <FolderIcon class="w-auto h-3" /> Changeset Summary
                    </div>
                    <ArrowIcon class="w-auto h-2.5 -rotate-90 text-text-secondary-v1" />
                  </div>

                  {/* Changelog entries list */}
                  <div class="ml-1.5 pl-2 border-l border-solid border-white/5 flex flex-col gap-0.5 pb-2">
                    {changelogEntries.map((entry) => (
                      <div
                        class={`w-full flex items-center gap-2 pl-1 rounded-md py-1 cursor-pointer transition-colors ${
                          entry.active
                            ? "text-primary-v1 bg-primary-v1/10 font-medium"
                            : "text-text-secondary-v1 hover:text-text-primary-v1"
                        }`}
                      >
                        <DocumentIcon class="w-auto h-2.5 flex-shrink-0" />
                        <span class="truncate">{entry.label}</span>
                      </div>
                    ))}
                  </div>

                  {/* Code Reference — COLLAPSED */}
                  <div class="text-text-secondary-v1 w-full flex justify-between gap-2 py-1 items-center hover:text-text-primary-v1 cursor-pointer transition-colors">
                    <div class="flex items-center gap-2">
                      <FolderIcon class="w-auto h-3" /> Code Reference
                    </div>
                    <ArrowIcon class="w-auto h-2.5 rotate-90 text-text-secondary-v1" />
                  </div>

                  {/* Guides — collapsed */}
                  <div class="text-text-secondary-v1 w-full flex justify-between gap-2 pt-2 pb-1 items-center hover:text-text-primary-v1 cursor-pointer transition-colors">
                    <div class="flex items-center gap-2">
                      <FolderIcon class="w-auto h-3" /> Guides
                    </div>
                    <ArrowIcon class="w-auto h-2.5 rotate-90 text-text-secondary-v1" />
                  </div>
                </>
              ) : (
                <>
                  {/* ── DEFAULT VARIANT ── */}

                  {/* changeset summary — collapsed */}
                  <div class="text-text-secondary-v1 w-full flex justify-between gap-2 py-1 items-center hover:text-text-primary-v1 cursor-pointer transition-colors">
                    <div class="flex items-center gap-2">
                      <FolderIcon class="w-auto h-3" /> Changeset Summary
                    </div>
                    <ArrowIcon class="w-auto h-2.5 rotate-90 text-text-secondary-v1" />
                  </div>

                  {/* code references — expanded */}
                  <div class="text-text-secondary-v1 w-full flex justify-between gap-2 py-1 items-center hover:text-text-primary-v1 cursor-pointer transition-colors">
                    <div class="flex items-center gap-2">
                      <FolderIcon class="w-auto h-3" /> Code Reference
                    </div>
                    <ArrowIcon class="w-auto h-2.5 -rotate-90 text-text-secondary-v1" />
                  </div>

                  {/* src folder (expanded) */}
                  <div class="text-text-secondary-v1 flex items-center justify-between gap-2 pl-2 ml-1.5 border-l border-solid border-white/5 pt-1 pb-1 hover:text-text-primary-v1 cursor-pointer transition-colors">
                    <div class="flex items-center gap-2">
                      <FolderIcon class="w-auto h-2.5" /> src
                    </div>
                    <ArrowIcon class="w-auto h-2 -rotate-90 text-text-secondary-v1" />
                  </div>

                  {/* src content */}
                  <div class="ml-1.5 pl-2 border-l border-solid border-white/5">
                    {/* app folder (expanded) */}
                    <div class="text-text-secondary-v1 flex items-center justify-between gap-2 pl-2 ml-1.5 border-l border-solid border-white/5 pt-1 pb-1 hover:text-text-primary-v1 cursor-pointer transition-colors">
                      <div class="flex items-center gap-2">
                        <FolderIcon class="w-auto h-2.5" /> app
                      </div>
                      <ArrowIcon class="w-auto h-2 -rotate-90 text-text-secondary-v1" />
                    </div>

                    {/* app content */}
                    <div class="ml-1.5 pl-2 border-l border-solid border-white/5">
                      <div class="text-text-secondary-v1 flex items-center justify-between gap-2 pl-2 ml-1.5 border-l border-solid border-white/5 pt-1 pb-1 hover:text-text-primary-v1 cursor-pointer transition-colors">
                        <div class="flex items-center gap-2">
                          <FolderIcon class="w-auto h-2.5" /> auth
                        </div>
                        <ArrowIcon class="w-auto h-2 rotate-90 text-text-secondary-v1" />
                      </div>

                      {/* api folder (expanded) */}
                      <div class="text-text-secondary-v1 flex items-center justify-between gap-2 pl-2 ml-1.5 border-l border-solid border-white/5 pt-1 pb-1 hover:text-text-primary-v1 cursor-pointer transition-colors">
                        <div class="flex items-center gap-2">
                          <FolderIcon class="w-auto h-2.5" /> api
                        </div>
                        <ArrowIcon class="w-auto h-2 -rotate-90 text-text-secondary-v1" />
                      </div>
                      {/* api content */}
                      <div class="text-primary-v1 w-full flex items-center gap-2 pl-1 ml-1.5 border-l border-solid border-primary-v1/20 pt-1 pb-1">
                        <div class="bg-primary-v1/10 px-1.5 py-1 w-full rounded-md flex items-center justify-start gap-2 font-medium">
                          <DocumentIcon class="w-auto h-2.5" /> API &amp;
                          Endpoints
                        </div>
                      </div>
                      <div class="text-text-secondary-v1 flex items-center justify-between gap-2 pl-2 ml-1.5 border-l border-solid border-white/5 pt-1 pb-1 hover:text-text-primary-v1 cursor-pointer transition-colors">
                        <div class="flex items-center gap-2">
                          <FolderIcon class="w-auto h-2.5" /> core
                        </div>
                        <ArrowIcon class="w-auto h-2 rotate-90 text-text-secondary-v1" />
                      </div>
                    </div>

                    {/* rest of src */}
                    <div class="text-text-secondary-v1 flex items-center justify-between gap-2 pl-2 ml-1.5 border-l border-solid border-white/5 pt-1 pb-1 hover:text-text-primary-v1 cursor-pointer transition-colors">
                      <div class="flex items-center gap-2">
                        <FolderIcon class="w-auto h-2.5" /> services
                      </div>
                      <ArrowIcon class="w-auto h-2 rotate-90 text-text-secondary-v1" />
                    </div>
                    <div class="text-text-secondary-v1 flex items-center justify-between gap-2 pl-2 ml-1.5 border-l border-solid border-white/5 pt-1 pb-1 hover:text-text-primary-v1 cursor-pointer transition-colors">
                      <div class="flex items-center gap-2">
                        <FolderIcon class="w-auto h-2.5" /> store
                      </div>
                      <ArrowIcon class="w-auto h-2 rotate-90 text-text-secondary-v1" />
                    </div>
                  </div>

                  {/* database folder */}
                  <div class="text-text-secondary-v1 flex items-center justify-between gap-2 pl-2 ml-1.5 border-l border-solid border-white/5 pt-1 pb-2 hover:text-text-primary-v1 cursor-pointer transition-colors">
                    <div class="flex items-center gap-2">
                      <FolderIcon class="w-auto h-2.5" /> database
                    </div>
                    <ArrowIcon class="w-auto h-2 rotate-90 text-text-secondary-v1" />
                  </div>

                  {/* guides */}
                  <div class="text-text-secondary-v1 w-full flex justify-between gap-2 pt-2 pb-1 items-center hover:text-text-primary-v1 cursor-pointer transition-colors">
                    <div class="flex items-center gap-2">
                      <FolderIcon class="w-auto h-3" /> Guides
                    </div>
                    <ArrowIcon class="w-auto h-2.5 -rotate-90 text-text-secondary-v1" />
                  </div>
                </>
              )
            }
          </div>
        </div>

        <!-- sidebar actions (fixed at bottom) -->
        <div
          class="absolute mb-10 bottom-0 left-0 w-full px-6 py-4 flex flex-col gap-2 bg-bg-secondary-v1"
        >
          <div
            class="w-full bg-white/5 hover:bg-white/10 transition-colors py-1 h-6 rounded-lg flex items-center justify-center gap-2 font-regular text-text-secondary-v1 cursor-pointer border border-white/5 text-[10px]"
          >
            <span class="text-xs">+</span> Create
          </div>
          <div
            class="w-full bg-primary-v1 hover:bg-primary-v1/90 transition-colors py-1 h-6 rounded-lg flex items-center justify-center gap-2 text-[10px] font-semibold text-text-primary-v1 cursor-pointer shadow-lg shadow-primary-v1/20"
          >
            <AutoAwsomeIcon class="w-3 h-3" /> Update Docs
          </div>
        </div>
      </div>

      <!-- editor -->
      <div
        class="bg-bg-main-v1 pt-2 w-3/4 h-full flex flex-col border-l border-white/5"
      >
        <!-- editor actions / DocNavbar -->
        <div
          class="px-4 flex items-center justify-end select-none border-b border-white/5 pb-2"
        >
          {
            isChangelog ? (
              <>
                <div class="flex items-center gap-2 flex-shrink-0">
                  <div class="bg-border-v1/50 hover:bg-border-v1 transition-colors rounded-md px-2 py-1 flex items-center gap-1 text-text-secondary-v1 text-[8px] font-medium cursor-pointer">
                    <AiGenerateIcon class="w-2 h-2" />
                    Regenerate
                  </div>
                  <div class="bg-primary-v1 hover:bg-primary-v1/90 transition-colors rounded-md px-2 py-1 flex items-center gap-1 text-text-primary-v1 text-[8px] font-semibold cursor-pointer">
                    <SaveIcon class="w-2 h-2" />
                    Save
                  </div>
                </div>
              </>
            ) : (
              <>
                <div class="bg-border-v1/50 hover:bg-border-v1 transition-colors rounded-md px-2.5 py-1 flex items-center gap-1.5 text-text-secondary-v1 hover:text-text-primary-v1 text-[9px] font-medium cursor-pointer">
                  <AiGenerateIcon class="w-2.5 h-2.5" />
                  Regenerate Doc
                </div>
                <div class="bg-primary-v1 hover:bg-primary-v1/90 transition-colors rounded-md px-2.5 py-1 flex items-center gap-1.5 text-text-primary-v1 text-[9px] font-semibold cursor-pointer">
                  <SaveIcon class="w-2.5 h-2.5" />
                  Save
                </div>
              </>
            )
          }
        </div>

        <!-- editor content (Tiptap-style prose editor) -->
        <div class="flex-1 flex min-h-0 overflow-hidden">
          {
            isChangelog ? (
              /* ── CHANGESET SUMMARY — real Penqwin release notes ── */
              <>
                {/* Main prose editor area */}
                <div class="flex-1 px-8 py-5 overflow-y-auto custom-scrollbar">
                  <div class="max-w-xl text-[10px] text-text-primary-v1 leading-relaxed space-y-4">
                    <div class="flex items-center gap-1.5 text-[8px] text-text-muted-v1">
                      <span class="text-[12px] font-bold text-text-primary-v1 truncate">
                        Changelog Generation &amp; DB Stability
                      </span>
                    </div>

                    {/* Intro paragraph */}
                    <p class="text-text-secondary-v1 leading-relaxed">
                      This release focuses on enhancing the stability,
                      reliability, and documentation generation capabilities of
                      Penqwin, including a new feature for generating
                      user-facing changelogs.
                    </p>

                    {/* Added */}
                    <div>
                      <h2 class="text-[12px] font-bold text-text-primary-v1 mb-3">
                        Added
                      </h2>
                      <ul class="space-y-3 text-text-secondary-v1">
                        <li class="flex gap-2">
                          <span class="text-text-muted-v1/50 flex-shrink-0">
                            •
                          </span>
                          <div>
                            <strong class="text-text-primary-v1">
                              Changelog Generation:
                            </strong>{" "}
                            You can now generate a user-facing Changelog
                            directly from selected Git commits. This new feature
                            creates a dedicated "Changelog" folder in your
                            sidebar, with documents summarizing the changes.
                            Documents within this folder are automatically
                            sorted with the newest entries first.
                          </div>
                        </li>
                      </ul>
                    </div>

                    {/* Fixed */}
                    <div>
                      <h2 class="text-[12px] font-bold text-text-primary-v1 mb-3 mt-6">
                        Fixed
                      </h2>
                      <ul class="space-y-3 text-text-secondary-v1">
                        <li class="flex gap-2">
                          <span class="text-text-muted-v1/50 flex-shrink-0">
                            •
                          </span>
                          <div>
                            <strong class="text-text-primary-v1">
                              Critical Database Stability:
                            </strong>{" "}
                            Addressed underlying IndexedDB corruption issues
                            (e.g.,{" "}
                            <code class="px-1 py-0.5 rounded bg-white/5 text-primary-v1 font-mono text-[9px]">
                              IDB QuotaManager crash
                            </code>
                            ) that could lead to data loss or application
                            instability. The system now includes automatic
                            database repair mechanisms and migrates to a more
                            resilient database version, significantly improving
                            data persistence and overall application
                            reliability.
                          </div>
                        </li>
                        <li class="flex gap-2">
                          <span class="text-text-muted-v1/50 flex-shrink-0">
                            •
                          </span>
                          <div>
                            <strong class="text-text-primary-v1">
                              Editor Typing Glitches:
                            </strong>{" "}
                            Resolved severe typing glitches and cursor jumps
                            that could occur within the document editor,
                            particularly when interacting with tables (e.g., on
                            Enter or Space key presses). This provides a
                            smoother and more reliable editing experience.
                          </div>
                        </li>
                        <li class="flex gap-2">
                          <span class="text-text-muted-v1/50 flex-shrink-0">
                            •
                          </span>
                          <div>
                            <strong class="text-text-primary-v1">
                              Resolved UI/Behavioral Quirks:
                            </strong>{" "}
                            Removed React StrictMode to prevent potential
                            conflicts with certain third-party libraries or
                            development behaviors, contributing to a more stable
                            overall application experience.
                          </div>
                        </li>
                        <li class="flex gap-2">
                          <span class="text-text-muted-v1/50 flex-shrink-0">
                            •
                          </span>
                          <div>
                            <strong class="text-text-primary-v1">
                              Minor Image Path Correction:
                            </strong>{" "}
                            Corrected internal asset paths to ensure all
                            application images load reliably.
                          </div>
                        </li>
                      </ul>
                    </div>

                    {/* Changed */}
                    <div>
                      <h2 class="text-[12px] font-bold text-text-primary-v1 mb-3 mt-6">
                        Changed
                      </h2>
                      <ul class="space-y-3 text-text-secondary-v1">
                        <li class="flex gap-2">
                          <span class="text-text-muted-v1/50 flex-shrink-0">
                            •
                          </span>
                          <div>
                            <strong class="text-text-primary-v1">
                              Improved Navigation System:
                            </strong>{" "}
                            Refactored internal routing and navigation to use a
                            centralized system of constants. This makes the
                            application's navigation more robust, consistent,
                            and easier to maintain. An alias for{" "}
                            <code class="px-1 py-0.5 rounded bg-white/5 text-primary-v1 font-mono text-[9px]">
                              /dashboard
                            </code>{" "}
                            has been added to automatically redirect to the home
                            page (
                            <code class="px-1 py-0.5 rounded bg-white/5 text-primary-v1 font-mono text-[9px]">
                              /
                            </code>
                            ).
                          </div>
                        </li>
                        <li class="flex gap-2">
                          <span class="text-text-muted-v1/50 flex-shrink-0">
                            •
                          </span>
                          <div>
                            <strong class="text-text-primary-v1">
                              Enhanced Code Reference Sync:
                            </strong>{" "}
                            The process for synchronizing code references after
                            documentation generation has been improved,
                            including better handling of file exclusion and more
                            detailed progress reporting during the bootstrap
                            process.
                          </div>
                        </li>
                        <li class="flex gap-2">
                          <span class="text-text-muted-v1/50 flex-shrink-0">
                            •
                          </span>
                          <div>
                            <strong class="text-text-primary-v1">
                              Refined Changelog Prompting:
                            </strong>{" "}
                            The AI model's instructions for generating
                            changelogs have been updated to explicitly request
                            the inclusion of commit details, ensuring more
                            comprehensive and informative release notes.
                          </div>
                        </li>
                      </ul>
                    </div>

                    {/* Commits */}
                    <div>
                      <h2 class="text-[12px] font-bold text-text-primary-v1 mb-3 mt-6">
                        Commits in this Release
                      </h2>
                      <ul class="space-y-2 mb-12 text-text-secondary-v1 font-mono text-[9px]">
                        <li class="flex gap-2">
                          <span class="text-text-muted-v1/50 flex-shrink-0">
                            •
                          </span>
                          <div>
                            <code class="px-1 py-0.5 rounded bg-white/5 text-primary-v1 font-mono text-[9px]">
                              acd2020
                            </code>{" "}
                            - Fix TipTap typing glitch and remove React
                            StrictMode
                          </div>
                        </li>
                        <li class="flex gap-2">
                          <span class="text-text-muted-v1/50 flex-shrink-0">
                            •
                          </span>
                          <div>
                            <code class="px-1 py-0.5 rounded bg-white/5 text-primary-v1 font-mono text-[9px]">
                              9b18420
                            </code>{" "}
                            - Merge branch 'main' of
                            github.com:Penqwin/desktop-app into
                            feature/setup-build-and-ui
                          </div>
                        </li>
                        <li class="flex gap-2">
                          <span class="text-text-muted-v1/50 flex-shrink-0">
                            •
                          </span>
                          <div>
                            <code class="px-1 py-0.5 rounded bg-white/5 text-primary-v1 font-mono text-[9px]">
                              613f501
                            </code>{" "}
                            - commit details in changelog doc
                          </div>
                        </li>
                      </ul>
                    </div>
                  </div>
                </div>
              </>
            ) : (
              /* ── DEFAULT / CODE REFERENCE CONTENT ── */
              <div class="text-editor group/editor w-full h-full max-w-2xl text-[10px] text-text-primary-v1 leading-relaxed">
                <div class="section mb-6">
                  <h3 class="text-sm font-semibold mb-3 text-text-primary-v1 tracking-tight">
                    Authentication &amp; Authorization
                  </h3>
                  <p class="mb-4">
                    Security is enforced at the route level through server-side
                    session validation. Most endpoints utilize the{" "}
                    <code>createClient</code> utility to interact with database,
                    ensuring that data access respects the authenticated user's
                    permissions.
                  </p>
                  <h4 class="text-[11px] font-semibold mb-3 text-text-primary-v1 tracking-tight">
                    Administrative Access
                  </h4>
                  <p class="inline">
                    For operations that require cross-workspace visibility,
                    state transitions that bypass high-level configuration
                    changes (e.g., repository mapping discovery), the system
                    utilizes <code>superiorClient</code>.&nbsp;
                    <div class="relative inline-flex items-center text-text-primary-v1 font-semibold group-hover/editor:bg-accent transition-colors cursor-default">
                      Authorization
                      <div class="floating-menu select-none absolute -top-10 left-1/2 -translate-x-1/2 scale-90 opacity-0 group-hover/editor:opacity-100 group-hover/editor:scale-100 transition-all pointer-events-none group-hover:pointer-events-auto w-fit h-fit flex flex-shrink-0 items-center gap-2 bg-bg-secondary-v1 backdrop-blur-md text-text-secondary-v1 px-2 py-1.5 border border-white/10 rounded-xl shadow-xl z-[999]">
                        <div class="border border-white/5 pl-2 pr-1 py-0.5 text-[8px] rounded-md flex items-center gap-1 font-medium bg-white/5">
                          Paragraph{" "}
                          <ArrowIcon class="w-auto h-2 rotate-90 text-text-secondary-v1" />
                        </div>

                        <div class="flex gap-2 items-center px-1 border-l border-white/5">
                          <div class="text-text-primary-v1 transition-colors cursor-pointer">
                            <BoldIcon class="w-2.5 h-2.5" />
                          </div>
                          <div class="hover:text-text-primary-v1 transition-colors cursor-pointer">
